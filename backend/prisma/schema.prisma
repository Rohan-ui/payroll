  created_by                               rndtechnosoft_tenant_members?              @relation("letterhead_created_by", fields: [tenant_id, created_by_tenant_member_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_letterheads_created_by")
