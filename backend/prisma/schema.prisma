/// Every email of a sequence, from scheduled to sent (or failed or cancelled): the schedule and the send log in one. One row per enrollment and step, so a step is never sent twice.
model rndtechnosoft_email_sequence_sends {
  id                     String    @id @db.Uuid
  tenant_id              String    @db.Uuid
  sequence_id            String    @db.Uuid
  step_id                String    @db.Uuid
  enrollment_id          String    @db.Uuid
  lead_id                String    @db.Uuid
  /// SCHEDULED, SENDING, SENT, FAILED, UNCERTAIN (the server may have taken it; a person decides), CANCELLED or BOUNCED.
  send_status            String    @default("SCHEDULED") @db.VarChar(16)
  scheduled_at           DateTime  @db.Timestamptz(6)
  attempt_count          Int       @default(0)
  claimed_at             DateTime? @db.Timestamptz(6)
  definition_version     Int
  recipient_email        String    @db.VarChar(320)
  /// ORGANIZATION, PERSONAL or GMAIL, and the account's address and (for a member's account) the member.
  sender_kind            String?   @db.VarChar(16)
  sender_email           String?   @db.VarChar(320)
  sender_member_id       String?   @db.Uuid
  /// What was sent, as sent.
  subject                String?   @db.VarChar(300)
  body_text              String?   @db.Text
  /// The Message-ID this email carries, set before sending; replies and bounces are matched by it.
  message_id             String?   @db.VarChar(255)
  provider_message_id    String?   @db.VarChar(255)
  /// SHA-256 of the email's unsubscribe token; the token itself is only in the email.
  unsubscribe_token_hash String?   @unique(map: "uq_email_sequence_sends_unsubscribe") @db.Char(64)
  failure_code           String?   @db.VarChar(48)
  failure_reason         String?   @db.VarChar(500)
  cancel_reason          String?   @db.VarChar(32)
  /// HARD or SOFT, for a bounced email.
  bounce_kind            String?   @db.VarChar(8)
  sent_at                DateTime? @db.Timestamptz(6)
  failed_at              DateTime? @db.Timestamptz(6)
  cancelled_at           DateTime? @db.Timestamptz(6)
  replied_at             DateTime? @db.Timestamptz(6)
  bounced_at             DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at             DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)

  rndtechnosoft_email_sequences            rndtechnosoft_email_sequences            @relation(fields: [tenant_id, sequence_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_email_sequence_sends_sequence")
  rndtechnosoft_email_sequence_steps       rndtechnosoft_email_sequence_steps       @relation(fields: [tenant_id, step_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_email_sequence_sends_step")
  rndtechnosoft_email_sequence_enrollments rndtechnosoft_email_sequence_enrollments @relation(fields: [tenant_id, enrollment_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_email_sequence_sends_enrollment")
  rndtechnosoft_crm_leads                  rndtechnosoft_crm_leads                  @relation(fields: [tenant_id, lead_id], references: [tenant_id, id], onDelete: Cascade, onUpdate: NoAction, map: "fk_email_sequence_sends_lead")
  rndtechnosoft_email_sequence_events      rndtechnosoft_email_sequence_events[]

  @@unique([tenant_id, id], map: "uq_email_sequence_sends_tenant_id")
  @@unique([tenant_id, enrollment_id, step_id], map: "uq_email_sequence_sends_step")
  @@index([send_status, scheduled_at], map: "ix_email_sequence_sends_due")
  @@index([tenant_id, sequence_id, send_status], map: "ix_email_sequence_sends_sequence")
  @@index([tenant_id, sender_email, sent_at], map: "ix_email_sequence_sends_sender_day")
  @@index([tenant_id, message_id], map: "ix_email_sequence_sends_message")
}

