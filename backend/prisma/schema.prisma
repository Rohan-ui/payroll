  created_by                               rndtechnosoft_tenant_members?              @relation("email_sequence_created_by", fields: [tenant_id, created_by_tenant_member_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_email_sequences_created_by")
