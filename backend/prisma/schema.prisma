  is_logo_hidden              Boolean  @default(false)
  is_header_art_hidden        Boolean  @default(false)
  is_footer_art_hidden        Boolean  @default(false)
  is_logo_locked              Boolean  @default(false)
  is_header_art_locked        Boolean  @default(false)
  is_footer_art_locked        Boolean  @default(false)
  is_default                  Boolean  @default(false)
  is_archived                 Boolean  @default(false)
