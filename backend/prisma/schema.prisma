/// An automatic email sequence (drip): emails sent on a schedule to enrolled CRM leads until they reply, bounce, unsubscribe, close or are stopped.
model rndtechnosoft_email_sequences {
  id                          String    @id @db.Uuid
  tenant_id                   String    @db.Uuid
  sequence_name               String    @db.VarChar(120)
  description                 String?   @db.VarChar(500)
  /// DRAFT, ACTIVE, PAUSED or ARCHIVED. Only ACTIVE sends.
  sequence_status             String    @default("DRAFT") @db.VarChar(16)
  /// ORGANIZATION: the workspace's account. LEAD_OWNER: the lead owner's own account, when the workspace allows personal accounts.
  sender_mode                 String    @default("ORGANIZATION") @db.VarChar(16)
