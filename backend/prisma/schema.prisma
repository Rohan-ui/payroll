  logo_rotation_deg           Decimal  @default(0) @db.Decimal(5, 1)
  header_art_rotation_deg     Decimal  @default(0) @db.Decimal(5, 1)
  footer_art_rotation_deg     Decimal  @default(0) @db.Decimal(5, 1)
