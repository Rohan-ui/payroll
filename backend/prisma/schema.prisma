/// approved (0 when rejected), against the minutes recorded at the time.
model rndtechnosoft_overtime_approvals {
  id                          String   @id @db.Uuid
  tenant_id                   String   @db.Uuid
  employee_id                 String   @db.Uuid
  work_date                   DateTime @db.Date
  recorded_minutes            Int
  approved_minutes            Int
  decision                    String   @db.VarChar(16)
  note                        String?  @db.VarChar(500)
  decided_by_tenant_member_id String?  @db.Uuid
  decided_at                  DateTime @db.Timestamptz(6)
  created_at                  DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                  DateTime @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)

  rndtechnosoft_employees rndtechnosoft_employees       @relation(fields: [tenant_id, employee_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_overtime_approvals_employee")
  decided_by              rndtechnosoft_tenant_members? @relation("overtime_decided_by", fields: [tenant_id, decided_by_tenant_member_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_overtime_approvals_decided_by")

  @@unique([tenant_id, id], map: "uq_overtime_approvals_tenant_id")
  @@unique([tenant_id, employee_id, work_date], map: "uq_overtime_approvals_day")
}

/// Arrears from a salary revision back-dated into finalized payroll: the
/// finalized month worked out again on the new salary, and the difference,
/// paid in a later payroll. Finalized payslips are never changed.
model rndtechnosoft_salary_arrears {
  id                          String    @id @db.Uuid
  tenant_id                   String    @db.Uuid
  employee_id                 String    @db.Uuid
  salary_assignment_id        String    @db.Uuid
  payroll_period_id           String    @db.Uuid
  paid_earnings               Decimal   @db.Decimal(18, 2)
  revised_earnings            Decimal   @db.Decimal(18, 2)
  arrears_amount              Decimal   @db.Decimal(18, 2)
  calculation_detail          Json
  arrears_status              String    @default("PENDING") @db.VarChar(16)
  included_in_run_employee_id String?   @db.Uuid
  included_at                 DateTime? @db.Timestamptz(6)
  created_by_tenant_member_id String?   @db.Uuid
  created_at                  DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)
  updated_at                  DateTime  @default(dbgenerated("CURRENT_TIMESTAMP(6)")) @db.Timestamptz(6)

  rndtechnosoft_employees                   rndtechnosoft_employees                   @relation(fields: [tenant_id, employee_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_arrears_employee")
  rndtechnosoft_employee_salary_assignments rndtechnosoft_employee_salary_assignments @relation(fields: [tenant_id, salary_assignment_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_arrears_assignment")
  rndtechnosoft_payroll_periods             rndtechnosoft_payroll_periods             @relation(fields: [tenant_id, payroll_period_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_arrears_period")
  rndtechnosoft_payroll_run_employees       rndtechnosoft_payroll_run_employees?      @relation(fields: [tenant_id, included_in_run_employee_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_arrears_run_employee")
  created_by                                rndtechnosoft_tenant_members?             @relation("salary_arrears_created_by", fields: [tenant_id, created_by_tenant_member_id], references: [tenant_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_salary_arrears_created_by")

  @@unique([tenant_id, id], map: "uq_salary_arrears_tenant_id")
  @@unique([tenant_id, salary_assignment_id, payroll_period_id], map: "uq_salary_arrears_period")
  @@index([tenant_id, employee_id, arrears_status], map: "ix_salary_arrears_pending")
}
