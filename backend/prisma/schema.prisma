  header_art_y_mm             Decimal? @db.Decimal(6, 1)
  header_art_width_mm         Decimal? @db.Decimal(6, 1)
  header_art_height_mm        Decimal? @db.Decimal(6, 1)
  header_art_stretch          Boolean  @default(false)
  footer_art_x_mm             Decimal? @db.Decimal(6, 1)
  footer_art_y_mm             Decimal? @db.Decimal(6, 1)
  footer_art_width_mm         Decimal? @db.Decimal(6, 1)
  footer_art_height_mm        Decimal? @db.Decimal(6, 1)
  footer_art_stretch          Boolean  @default(false)
