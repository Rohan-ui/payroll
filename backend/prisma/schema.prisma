  rndtechnosoft_letterhead_assets rndtechnosoft_letterhead_assets? @relation(fields: [tenant_id, letterhead_id, asset_id], references: [tenant_id, letterhead_id, id], onDelete: NoAction, onUpdate: NoAction, map: "fk_letterhead_elements_asset")

  @@unique([tenant_id, letterhead_id, layer_order], map: "uq_letterhead_elements_layer")
  @@index([tenant_id, letterhead_id, asset_id], map: "ix_letterhead_elements_asset")
