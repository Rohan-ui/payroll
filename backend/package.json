{
  "name": "rndtechnosoft-payroll-backend",
  "version": "1.0.0",
  "description": "Production Payroll + HRMS SaaS Backend",
  "author": "rndtechnosoft",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "dev": "nest start --watch",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "start:cosec-sync": "nest start --entryFile cosec-sync.main",
    "start:cosec-sync:prod": "node dist/src/cosec-sync.main",
    "start:sequence-worker": "nest start --entryFile sequence-worker.main",
    "start:sequence-worker:prod": "node dist/src/sequence-worker.main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:studio": "prisma studio",
    "platform:admin": "ts-node -P tsconfig.json src/scripts/platform-admin.ts",
    "test": "NODE_OPTIONS=--experimental-vm-modules NODE_EXTRA_CA_CERTS=test/support/tls/localhost.crt jest",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules NODE_EXTRA_CA_CERTS=test/support/tls/localhost.crt jest --watch"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.0",
    "@nestjs/config": "^12.0.0",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-express": "^12.0.4",
    "@prisma/client": "^5.22.0",
    "@types/nodemailer": "^8.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "docx": "^9.15.0",
    "exceljs": "^4.4.0",
    "imapflow": "^2.0.6",
    "mailparser": "^3.9.28",
    "nodemailer": "^10.0.10",
    "pdfkit": "^0.20.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.3",
    "@nestjs/schematics": "^11.1.0",
    "@nestjs/testing": "^12.0.4",
    "@types/express": "^4.17.21",
    "@types/jest": "^30.0.0",
    "@types/mailparser": "^3.4.6",
    "@types/node": "^20.14.14",
    "@types/pdfkit": "^0.17.6",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "prisma": "^5.22.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.12",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.4"
  }
}
